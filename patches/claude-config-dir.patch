From 8f2a90fdf26ed1e9e424403769187455f6e078c0 Mon Sep 17 00:00:00 2001
From: Sebastian Bartoszewicz <quikstyletv@gmail.com>
Date: Thu, 29 Oct 2026 22:10:29 +0100
Subject: [PATCH] fix(claude): read settings, stats and transcripts from
 CLAUDE_CONFIG_DIR

Credentials and sessions already follow $CLAUDE_CONFIG_DIR through claude_config_dir(), but collect.py read settings.json and stats-cache.json from ~/.claude and claude_transcripts looked for projects/ there too, so a relocated config dir lost the plan settings and every transcript-derived stat.
---
 backend/tidesi/collect.py                      |  6 +++---
 backend/tidesi/providers/claude_transcripts.py |  3 ++-
 tests/python/test_claude_transcripts.py        | 18 ++++++++++++++++++
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/backend/tidesi/collect.py b/backend/tidesi/collect.py
index 7272d5d..0edcb3d 100644
--- a/backend/tidesi/collect.py
+++ b/backend/tidesi/collect.py
@@ -15,7 +15,7 @@ from .http import as_json, fetch_json, http_error_text
 from .pricing import get_pricing
 from .providers import claude_transcripts
 from .providers.antigravity import get_antigravity_usage
-from .providers.claude_credentials import get_claude_credentials
+from .providers.claude_credentials import claude_config_dir, get_claude_credentials
 from .providers.claude_remote import remote_sessions
 from .providers.cline import get_cline_sessions
 from .providers.coderabbit import get_coderabbit_usage
@@ -137,9 +137,9 @@ def collect_claude(now):
         if result.status == 200:
             org = as_json(result.body)
 
-    settings = read_json_file(os.path.expanduser("~/.claude/settings.json"))
+    settings = read_json_file(os.path.join(claude_config_dir(), "settings.json"))
     # Claude Code no longer refreshes stats-cache.json: the widget keeps its own copy and adds the days from the transcripts.
-    stats = claude_transcripts.load(read_json_file(os.path.expanduser("~/.claude/stats-cache.json")), now)
+    stats = claude_transcripts.load(read_json_file(os.path.join(claude_config_dir(), "stats-cache.json")), now)
     status = provider_status("claude")
 
     return {
diff --git a/backend/tidesi/providers/claude_transcripts.py b/backend/tidesi/providers/claude_transcripts.py
index 3a1fe1e..0827aff 100644
--- a/backend/tidesi/providers/claude_transcripts.py
+++ b/backend/tidesi/providers/claude_transcripts.py
@@ -18,6 +18,7 @@ import tempfile
 import time
 
 from .. import paths
+from .claude_credentials import claude_config_dir
 
 _CACHE_VERSION = 1
 _BUDGET_SECONDS = 8.0
@@ -155,7 +156,7 @@ def _build(stats, now, home, budget, through):
     """supplement(), limited to days up to ``through`` (YYYY-MM-DD) when given,
     and whether every transcript was read: the budget may cut it short."""
     stats = dict(stats) if isinstance(stats, dict) else {}
-    root = os.path.join(home or os.path.expanduser("~/.claude"), "projects")
+    root = os.path.join(home or claude_config_dir(), "projects")
     if not os.path.isdir(root):
         return stats, True
     now = now if now is not None else time.time()
diff --git a/tests/python/test_claude_transcripts.py b/tests/python/test_claude_transcripts.py
index 0ccc043..7f23c5c 100644
--- a/tests/python/test_claude_transcripts.py
+++ b/tests/python/test_claude_transcripts.py
@@ -62,6 +62,24 @@ class ClaudeTranscriptsTest(unittest.TestCase):
         stats = {"lastComputedDate": "2026-09-20"}
         self.assertEqual(claude_transcripts.supplement(stats, home=os.path.join(self.home, "none")), stats)
 
+    def test_transcripts_follow_the_config_dir(self):
+        stats = {"lastComputedDate": "2026-09-20"}
+        with mock.patch.dict(os.environ, {"CLAUDE_CONFIG_DIR": self.home}):
+            out = claude_transcripts.supplement(stats)
+        self.assertEqual(out["dailyActivity"][-1]["messageCount"], 2)
+
+    def test_transcripts_follow_a_config_dir_outside_home(self):
+        # The transcripts live only in the relocated dir; ~/.claude does not exist.
+        user = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, user, True)
+        config_dir = os.path.join(user, ".config", "claude-code")
+        shutil.copytree(self.home, config_dir)
+        stats = {"lastComputedDate": "2026-09-20"}
+        # expanduser reads HOME on POSIX and USERPROFILE on Windows.
+        with mock.patch.dict(os.environ, {"HOME": user, "USERPROFILE": user, "CLAUDE_CONFIG_DIR": config_dir}):
+            out = claude_transcripts.supplement(stats)
+        self.assertEqual(out["dailyActivity"][-1]["messageCount"], 2)
+
     def test_load_keeps_finished_days_in_the_widgets_own_file(self):
         legacy = {"lastComputedDate": "2026-09-20", "totalSessions": 5}
         now = 1792000000 + 3 * 86400  # a few days after the transcript's day
-- 
2.56.0

